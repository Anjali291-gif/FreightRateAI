# FreightAI – Environment Variable Reference
# Copy this file to .env (root) or set these in Vercel Dashboard → Project Settings → Environment Variables

# ──────────────────────────────────────────────────────────────
# FRONTEND (set in Vercel project for the frontend build)
# ──────────────────────────────────────────────────────────────

# Override the API base URL. Leave empty to use relative /api (same-domain Vercel deployment).
# Only needed when backend is deployed on a DIFFERENT domain than the frontend.
# Example: VITE_API_URL=https://freightai-backend.vercel.app/api
VITE_API_URL=

# ──────────────────────────────────────────────────────────────
# BACKEND (set in Vercel project for the Python serverless function)
# ──────────────────────────────────────────────────────────────

# Allow a specific additional CORS origin (e.g. frontend on a separate Vercel domain)
# Example: CORS_ORIGIN=https://freight-rate-ai.vercel.app
CORS_ORIGIN=

# Absolute path override for project root (auto-detected in most cases, leave empty)
PROJECT_ROOT=
