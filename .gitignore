# ==========================================================
# FreightAI – Git Ignore Configuration
# ==========================================================

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Node & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
.npm
.eslintcache

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Operating System & IDE Files
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log
*.lnk
*.tmp
*.bak

# Large ML model — excluded from git (too big: 51 MB)
# The 574 KB Gradient Boosting model (best_model.joblib) IS tracked for Vercel deployment
models/saved_models/random_forest_regressor.joblib

# Intermediate processed CSVs (large split files, re-generated by preprocess.py)
data/processed/*.csv

# Keep folder structure sentinel files
!data/processed/.gitkeep
!data/raw/.gitkeep
!models/saved_models/.gitkeep
